# Hackathon Kit config. No secrets here: keys live in .env (gitignored).
# scripts/init fills this in; edit by hand any time and commit it.
KIT_EVENT="Gemini 4 NYC Hackathon"          # event name
KIT_REPO="tech-cosmos/gemini-hack"           # owner/name. Empty = read it from the git remote
KIT_LEAD="tech-cosmos"           # GitHub login of the team lead. Empty = the repo owner
KIT_START="2026-11-21T10:30"          # local time building starts, YYYY-MM-DDTHH:MM
KIT_DEADLINE="2026-11-21T17:00"       # local time of the hard submission deadline, YYYY-MM-DDTHH:MM
KIT_LOG_ISSUE="1"     # number of the live-log issue
KIT_ACK_MIN="10"      # minutes before a directive nobody acked is flagged to the lead
KIT_BUDGET_USD=""     # team budget for paid APIs, if there is one
KIT_NOTIFY="1"        # 1 = scripts/watch also shows a desktop notification (macOS)

# Gates: percent of the build window | what must be true by then.
# Miss a gate: cut scope, don't slip. scripts/clock shows the times.
KIT_GATES="
5|Submission facts filled in docs/SUBMISSION.md; every agent ran scripts/catchup; lanes claimed
65|Idea picked by spike test (docs/IDEAS.md) and written in docs/DECISIONS.md (lead moved this to ~14:45, after the Click-Brake result)
70|docs/DEMO.md written; golden path defined in scripts/check; shared formats frozen
75|Golden path runs end to end on main (mock data is fine)
86|Real results on main; every number in docs/EVIDENCE.md
92|FEATURE FREEZE (lead moved this to ~16:30): only fixes, README, demo video and slides from here
96|Repo stripped of kit files and made public; submission form filled; video recorded
98|Submitted. Rehearse the 3-minute live demo twice with a timer
"
