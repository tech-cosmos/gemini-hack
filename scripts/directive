#!/usr/bin/env bash
# Team lead only: send a directive (an agreed team task that is done before other work).
#   scripts/directive "maya: merge the eval PR, then run the pilot"
#   scripts/directive "maya, sam: read docs/DEMO.md and learn your part"
#   scripts/directive "everyone: feature freeze, only fixes from now"
# The people named before the first colon are assigned, so only they see it on every message.
. "$(dirname "$0")/lib.sh"
[ $# -ge 1 ] || { echo 'usage: scripts/directive "<who>: <what>"' >&2; exit 1; }
repo=$(kit_repo)
if ! kit_is_lead; then
  echo "Only the lead ($(kit_lead)) sends directives. Ask instead: scripts/request \"<what you need>\"" >&2
  exit 1
fi
text="$*"
case "$text" in *:*) ;; *) echo 'start with who it is for, e.g. "maya: ..." or "everyone: ..."' >&2; exit 1;; esac
who=${text%%:*}
args=""; everyone=0; named=0
for w in $(printf '%s' "$who" | tr ',+&' '   '); do
  w=${w#@}
  case "$(kit_lc "$w")" in
    everyone|all|team) everyone=1 ;;
    and) ;;
    *) if gh api "repos/$repo/collaborators/$w" >/dev/null 2>&1; then
         args="$args --assignee $w"; named=1
       else
         echo "note: '$w' is not a collaborator on $repo, so I can't assign them" >&2
       fi ;;
  esac
done
# A directive nobody is assigned to would be invisible: show it to everyone instead.
if [ "$named" = 0 ] && [ "$everyone" = 0 ]; then
  echo "note: nobody could be assigned, so this goes to everyone" >&2; everyone=1
fi
[ "$everyone" = 1 ] && args="$args --label everyone"
# shellcheck disable=SC2086
url=$(gh issue create --repo "$repo" --label directive $args --title "DIRECTIVE: $text" \
  --body "Agreed team task from the lead. Do it before other work.

1. \`scripts/ack <this number>\` within ${KIT_ACK_MIN:-10} minutes, so the lead knows you saw it.
2. Do it.
3. \`scripts/done <this number> \"what you did\"\` (this closes it when everyone named is done).

Can't do it? Comment why, here, right away.") || { echo "could not create the directive" >&2; exit 1; }
who=${LOG_WHO:-}
[ -n "$who" ] || who="$(kit_me)'s agent (lead)"
LOG_WHO="$who" bash "$(dirname "$0")/log" "📌 New directive: $text ($url)" >/dev/null
echo "$url"
