#!/usr/bin/env bash
# Take an issue and its folder, after checking nobody else is already on either one.
#   scripts/claim 14               folders come from the issue's "**Folder:**" line
#   scripts/claim 14 gen/topo web  or name them
#   scripts/claim --force 14       claim even though someone else has work in that folder
# It refuses when: the issue has another owner, another owner's open issue names the same folder,
# or someone else's open PR already changes files in it. That is how duplicate builds are stopped.
. "$(dirname "$0")/lib.sh"
force=0
if [ "${1:-}" = "--force" ]; then force=1; shift; fi
[ $# -ge 1 ] || { echo 'usage: scripts/claim [--force] <issue number> [folder ...]' >&2; exit 1; }
repo=$(kit_repo); me=$(kit_lc "$(kit_me)")
[ -n "$repo" ] && [ -n "$me" ] || { echo "gh is not signed in, or this folder has no GitHub remote" >&2; exit 1; }
n=${1#\#}; shift

owners() {
  gh issue view "$n" --repo "$repo" --json assignees \
    --jq "[.assignees[].login | select(ascii_downcase != \"$me\")] | join(\", \")"
}
o=$(owners) || { echo "issue #$n not found in $repo" >&2; exit 1; }
if [ -n "$o" ]; then
  echo "✗ #$n already belongs to $o. Take another issue, or: scripts/request \"...\"" >&2; exit 1
fi

folders="$*"
if [ -z "$folders" ]; then
  folders=$(gh issue view "$n" --repo "$repo" --json body --jq .body \
    | sed -n 's/^\*\*Folder:\*\*[[:space:]]*//p' | head -1 | tr -d '`\r' | tr ',' ' ')
fi

conflicts=""
for f in $folders; do
  f=${f%/}
  [ -n "$f" ] || continue
  # shellcheck disable=SC2016
  q='.[] | select(.number != __N__)
     | select([.assignees[].login | ascii_downcase] | (length > 0 and (index("__ME__") == null)))
     | ((.body // "") | [scan("\\*\\*Folder:\\*\\*([^\\r\\n]*)")] | (.[0][0] // "")
        | gsub("[`,]"; " ") | split(" ") | map(select(length > 0) | sub("/$"; ""))) as $fs
     | select($fs | any(. as $e | $e == "__F__" or ($e | startswith("__F__/")) or ("__F__" | startswith($e + "/"))))
     | "issue #\(.number) (\([.assignees[].login] | join(", "))) already covers __F__"'
  q=${q//__N__/$n}; q=${q//__ME__/$me}; q=${q//__F__/$f}
  c=$(gh issue list --repo "$repo" --state open --limit 100 --json number,assignees,body --jq "$q" 2>/dev/null)
  # shellcheck disable=SC2016
  q='.[] | select(.author.login | ascii_downcase != "__ME__")
     | select([.files[].path] | any(. == "__F__" or startswith("__F__/")))
     | "PR #\(.number) by \(.author.login) already changes __F__"'
  q=${q//__ME__/$me}; q=${q//__F__/$f}
  p=$(gh pr list --repo "$repo" --state open --limit 50 --json number,author,files --jq "$q" 2>/dev/null)
  [ -n "$c" ] && conflicts="$conflicts$c
"
  [ -n "$p" ] && conflicts="$conflicts$p
"
done
if [ -n "$conflicts" ]; then
  printf '%s' "$conflicts" | sed 's/^/✗ /' >&2
  if [ "$force" = 0 ]; then
    echo "Not claimed. Talk to that owner or the lead first (scripts/request), or rerun with --force if the lead said so." >&2
    exit 1
  fi
  echo "(--force: claiming anyway)" >&2
fi

gh issue edit "$n" --repo "$repo" --add-assignee "@me" >/dev/null || { echo "could not assign #$n" >&2; exit 1; }
o=$(owners)
if [ -n "$o" ]; then   # two agents claimed in the same second: the later one backs off
  gh issue edit "$n" --repo "$repo" --remove-assignee "@me" >/dev/null
  echo "✗ #$n was claimed by $o at the same moment. Take another issue." >&2; exit 1
fi
echo "✓ #$n is yours${folders:+ (folders: $folders)}"
bash "$(dirname "$0")/log" "claimed #$n${folders:+ ($folders)}" >/dev/null
exit 0
