#!/usr/bin/env bash
# Push instead of pull: prints one line the moment something needs you.
#   DIRECTIVE  a new directive for you or for everyone
#   ASSIGNED   an issue was assigned to you (HUMAN = a task only your person can do)
#   REPLY      someone commented on an issue you own or opened
#   GATE       the clock passed a gate            CLOCK  60 / 30 / 10 minutes to the deadline
#   lead only: REQUEST, BLOCKED, NO-ACK (a directive nobody acked in KIT_ACK_MIN minutes)
#
# Claude Code: run it with the Monitor tool (each line becomes a notification); start it again when it
# expires. Any other tool: leave it running in a spare terminal. On macOS your person also gets a
# desktop notification for DIRECTIVE, HUMAN, GATE and CLOCK lines.
#   scripts/watch          loop (first pass is silent: scripts/catchup already showed the current state)
#   scripts/watch --once   print the current state once and exit
. "$(dirname "$0")/lib.sh"
once=0; [ "${1:-}" = "--once" ] && once=1
repo=$(kit_repo); me=$(kit_lc "$(kit_me)"); log=${KIT_LOG_ISSUE:-1}
[ -n "$repo" ] && [ -n "$me" ] || { echo "watch: gh is not signed in, or this folder has no GitHub remote"; exit 1; }
every=${KIT_WATCH_SEC:-45}
lead=0; kit_is_lead && lead=1
seen=" "; mine=" "; since=$(date -u +%Y-%m-%dT%H:%M:%SZ)
has()  { case "$seen" in *" $1 "*) return 0 ;; esac; return 1; }
mark() { seen="$seen$1 "; }
# say <key> <line> [notify text]: print the line once per key
say() {
  has "$1" && return 0
  mark "$1"
  [ "$quiet" = 1 ] && return 0
  printf '%s\n' "$2"
  [ -n "${3:-}" ] && kit_notify "$3"
  return 0
}

pass() {
  local line n a b labels author title id who body p pct left g t m l
  # 1. directives (and, for the lead, the ones nobody acked)
  while IFS= read -r line; do
    case "$line" in
      "⚠ #"*) n=${line#"⚠ #"}; n=${n%% *}; say "noack-$n" "NO-ACK ${line#"⚠ "}" "No ack: ${line#"⚠ "}" ;;
      "#"*)   n=${line#"#"}; n=${n%% *}; line=${line%%   <- *}
              say "dir-$n" "DIRECTIVE $line  -> scripts/ack $n, then do it before anything else" "Directive: $line" ;;
    esac
  done <<EOF
$(kit_directive_lines)
EOF
  # 2. issues: new assignments; for the lead, requests and blocked work
  mine=" "
  # shellcheck disable=SC2016
  q='.[] | [ .number,
             (if ([.assignees[].login | ascii_downcase] | index("__ME__")) != null then "y" else "n" end),
             (if (.author.login | ascii_downcase) == "__ME__" then "y" else "n" end),
             ("L:" + ([.labels[].name] | join(","))), .author.login, .title[0:100] ] | @tsv'
  q=${q//__ME__/$me}
  while IFS="$(printf '\t')" read -r n a b labels author title; do
    [ -n "$n" ] && [ "$n" != "$log" ] || continue
    if [ "$a" = y ] || [ "$b" = y ]; then mine="$mine$n "; fi
    case ",${labels#L:}," in *,directive,*) continue ;; esac
    l=",${labels#L:},"
    case "$l" in
      *,request,*)   # one line for the lead, none for the person who asked
        if [ "$lead" = 1 ] && [ "$b" != y ]; then
          case "$l" in
            *,blocked,*) say "req-$n" "REQUEST (BLOCKED) #$n from $author: ${title#request: }  -> answer now, a lane is waiting" ;;
            *)           say "req-$n" "REQUEST #$n from $author: ${title#request: }" ;;
          esac
        fi ;;
      *)
        if [ "$a" = y ]; then
          case "$l" in
            *,human,*) say "asg-$n" "ASSIGNED (HUMAN) #$n $title  -> tell your person now: only they can do this" "For you, in person: #$n $title" ;;
            *)         say "asg-$n" "ASSIGNED #$n $title" ;;
          esac
        fi
        if [ "$lead" = 1 ]; then
          case "$l" in *,blocked,*) say "blk-$n" "BLOCKED #$n ($author): $title" ;; esac
        fi ;;
    esac
  done <<EOF
$(gh issue list --repo "$repo" --state open --limit 100 --json number,title,assignees,author,labels --jq "$q" 2>/dev/null)
EOF
  # 3. replies on issues you own or opened
  # shellcheck disable=SC2016
  q='.[] | select((.user.login | ascii_downcase) != "__ME__")
     | [ .id, (.issue_url | split("/") | last), .user.login, (.body | gsub("[\r\n\t]+"; " ") | .[0:180]) ] | @tsv'
  q=${q//__ME__/$me}
  while IFS="$(printf '\t')" read -r id n who body; do
    [ -n "$id" ] || continue
    case "$mine" in *" $n "*) say "c-$id" "REPLY #$n from $who: $body" ;; esac
  done <<EOF
$(gh api "repos/$repo/issues/comments?since=$since&per_page=100" --jq "$q" 2>/dev/null)
EOF
  # 4. the clock
  if p=$(kit_progress); then
    pct=${p% *}; left=${p#* }
    while IFS='|' read -r g t; do
      [ -n "$g" ] || continue
      [ "$g" -le "$pct" ] && say "gate-$g" "GATE $g% ($(kit_gate_time "$g")): $t" "Gate $g%: $t"
    done <<EOF
$(kit_gates)
EOF
    for m in 60 30 10; do
      [ "$left" -le "$m" ] && [ "$left" -ge 0 ] && say "left-$m" "CLOCK $left min to the deadline ($(kit_hm "$(kit_epoch "$KIT_DEADLINE")"))" "$left min to the deadline"
    done
    [ "$left" -lt 0 ] && say "over" "CLOCK the deadline has passed" "The deadline has passed"
  fi
  return 0
}

if [ "$once" = 1 ]; then quiet=0; pass; exit 0; fi
quiet=1; pass; quiet=0
echo "watching $repo for $me every ${every}s"
while true; do
  sleep "$every"
  t=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  pass
  since=$t
done
