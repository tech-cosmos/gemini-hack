#!/usr/bin/env bash
# After the event: who closed what and who wrote what. For the write-up, not for ranking people:
# agents wrote most of it, and work done away from the repo (baselines, rehearsals) does not show.
. "$(dirname "$0")/lib.sh"
repo=$(kit_repo)
echo "== Issues =="
gh issue list --repo "$repo" --state all --limit 500 --json state,labels --jq '
  "total \(length) · closed \(map(select(.state == "CLOSED")) | length) · open \(map(select(.state == "OPEN")) | length) · directives \(map(select([.labels[].name] | index("directive") != null)) | length)"'
echo; echo "== Issues closed, by who closed them =="
gh api "repos/$repo/issues?state=closed&per_page=100" --paginate \
  --jq '.[] | select(.pull_request | not) | (.closed_by.login // "?")' | sort | uniq -c | sort -rn
echo; echo "== PRs merged, by author =="
gh pr list --repo "$repo" --state merged --limit 500 --json author --jq '.[].author.login' | sort | uniq -c | sort -rn
echo; echo "== Commits on main, by author =="
git fetch -q origin 2>/dev/null
git log origin/main --no-merges --format='%an' | sort | uniq -c | sort -rn
echo; echo "== Lines added on main, by author (code = py js ts html css sh go rs + scripts/; docs = md) =="
git log origin/main --no-merges --numstat --format='@@%an' | awk -F'\t' '
  /^@@/ { who = substr($0, 3); next }
  NF == 3 && $1 != "-" {
    f = $3
    if (f ~ /(^|\/)(vendor|node_modules|dist|build)\//) next
    if (f ~ /\.(py|js|jsx|ts|tsx|html|css|sh|go|rs|swift|kt|java)$/ || f ~ /^scripts\// || f ~ /Dockerfile$/) code[who] += $1
    else if (f ~ /\.md$/) docs[who] += $1
    seen[who] = 1
  }
  END { for (w in seen) printf "%-24s code %7d   docs %6d\n", w, code[w], docs[w] }' | sort -k3 -rn
exit 0
