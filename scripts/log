#!/usr/bin/env bash
# Post one line to the live log. Usage: scripts/log "what happened (#issue)"
# Set LOG_WHO to say who is posting, e.g. LOG_WHO="maya's agent (Codex)". Default: "<your login>'s agent".
. "$(dirname "$0")/lib.sh"
[ $# -ge 1 ] || { echo 'usage: scripts/log "message"' >&2; exit 1; }
who=${LOG_WHO:-}
[ -n "$who" ] || who="$(kit_me)'s agent"
if gh issue comment "${KIT_LOG_ISSUE:-1}" --repo "$(kit_repo)" --body "**${who}** · $(date +%H:%M) · $*" >/dev/null; then
  echo "logged"
else
  echo "could not post to the live log (is gh signed in? does issue #${KIT_LOG_ISSUE:-1} exist?)" >&2
fi
# Directives reach an agent mid-task every time it logs.
bash "$(dirname "$0")/directives-check"
exit 0
