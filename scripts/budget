#!/usr/bin/env bash
# What the team has spent on paid APIs. Reads keys from .env and never prints them.
# Knows OpenRouter; add another provider's usage call below if the event gives you one.
# Prints nothing (exit 1) when there is no budget source, so scripts/catchup can skip the section.
cd "$(dirname "$0")/.." || exit 1
[ -f kit.env ] && . ./kit.env
k=$(grep -E '^OPENROUTER_API_KEY=.+' .env 2>/dev/null | head -1 | cut -d= -f2- | tr -d '"'"'"' \r')
[ -n "$k" ] || exit 1
json=$(curl -s --max-time 8 https://openrouter.ai/api/v1/key -H "Authorization: Bearer $k") || exit 1
num() { printf '%s' "$json" | sed -nE "s/.*\"$1\":[[:space:]]*([0-9.]+).*/\1/p" | head -1; }
used=$(num usage); limit=$(num limit)
[ -n "$used" ] || exit 1
printf 'OpenRouter: $%.2f used' "$used"
[ -n "$limit" ] && printf ' of $%s' "$limit"
[ -n "${KIT_BUDGET_USD:-}" ] && printf ' · team budget $%s' "$KIT_BUDGET_USD"
echo
