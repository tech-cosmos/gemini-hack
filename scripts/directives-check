#!/usr/bin/env bash
# Prints the open directives that are for YOU, and nothing when there are none.
# Claude Code runs this on every message (hook); other tools run it before each task.
#   scripts/directives-check        with a header
#   scripts/directives-check --raw  lines only (used by scripts/watch)
. "$(dirname "$0")/lib.sh"
out=$(kit_directive_lines)
[ -n "$out" ] || exit 0
if [ "${1:-}" = "--raw" ]; then printf '%s\n' "$out"; exit 0; fi
printf '📌 OPEN DIRECTIVES for %s (do these first: scripts/ack <N>, then scripts/done <N> "what you did"):\n%s\n' "$(kit_me)" "$out"
exit 0
